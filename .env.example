# This file is a TEMPLATE — copy it to .env and fill real values

# Database
POSTGRES_USER=                    # choose any username
POSTGRES_PASSWORD=                # choose any password
POSTGRES_DB=                      # choose any db name
DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/dbname

# Redis
REDIS_URL=redis://redis:6379

# App
SECRET_KEY=
ENVIRONMENT=development
DEBUG=true

# JWT (we'll use these in Phase 2)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256